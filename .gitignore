# ============================================================
# 진짜 금융 데이터는 절대 커밋되지 않는다
# ============================================================
data/private/*
!data/private/README.md

# 분석 결과물 (실제 거래 내역이 들어 있음)
out/*
!out/.gitkeep

# ------------------------------------------------------------
# 2차 방어 — 파일 이름·확장자로 한 번 더 막는다
# ------------------------------------------------------------
거래통합*.csv
우리집_점검*.html
우리집_머니리포트*.html
대시보드*.html
# docs/index.html 은 예시 자료로 만든 발표용 페이지라서 일부러 올린다
!docs/index.html
*.sqlite
*.db

# 내 보험 증권 (템플릿과 가상 예시만 커밋한다)
templates/보험_내정보*.csv
보험_내정보*.csv

# API 키 — 절대 커밋되지 않게
*.key
gemini.key
.env

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/

# ------------------------------------------------------------
# OS / 편집기
# ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
~$*.xlsx
~$*.csv
